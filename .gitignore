# --- ML & Data Artifacts ---
# We commit the mapping LOGIC, but never the local data itself.
# We also avoid committing large FAISS index binaries.
resonance-ml/data/*
!resonance-ml/data/.keep
resonance-ml/*.index
resonance-ml/*.index_ids

