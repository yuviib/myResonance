<div class="max-w-6xl mx-auto px-8 py-12">
  <div class="mb-12">
    <h1 class="text-4xl font-display font-black text-white tracking-tighter mb-8">Search</h1>
    
    <%= form_with url: search_path, method: :get, class: "relative group" do |f| %>
      <i data-lucide="search" class="absolute left-6 top-1/2 -translate-y-1/2 w-6 h-6 text-slate-500 group-focus-within:text-brand-primary transition-colors"></i>
      <%= f.text_field :q, value: params[:q], placeholder: "What do you want to listen to?", 
          class: "w-full bg-white/[0.03] border border-white/10 rounded-[2rem] py-6 pl-16 pr-8 text-xl text-white placeholder:text-slate-700 outline-none focus:border-brand-primary/50 focus:bg-white/[0.05] transition-all" %>
    <% end %>
  </div>

  <% if @query.present? || @genre.present? %>
    <div class="mb-8 flex items-center gap-4">
      <% if @genre %>
        <span class="px-4 py-1.5 rounded-full bg-brand-primary/10 text-brand-primary text-sm font-bold border border-brand-primary/20">
          Genre: <%= @genre.capitalize %>
        </span>
      <% end %>
      <%= link_to "Clear filters", search_path, class: "text-xs font-bold text-slate-600 hover:text-white transition-colors" if @genre || @query %>
    </div>

    <div class="space-y-16">
      <!-- Tracks Results -->
      <% if @tracks.any? %>
        <section>
          <h2 class="text-2xl font-display font-black text-white mb-6 tracking-tight">Songs</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <% @tracks.each do |track| %>
              <div class="group p-4 rounded-[2rem] bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] transition-all duration-500">
                <div class="aspect-square rounded-2xl bg-white/5 mb-4 overflow-hidden relative border border-white/5 shadow-lg">
                  <% if track.album.cover_url.present? %>
                    <img src="<%= track.album.cover_url %>" class="w-full h-full object-cover group-hover:scale-110 transition-all duration-700">
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-white/5 to-white/[0.02]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music text-slate-800"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    </div>
                  <% end %>
                  <button
                    class="absolute bottom-4 right-4 w-12 h-12 rounded-full bg-brand-primary text-bg-deep flex items-center justify-center translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 shadow-xl shadow-brand-primary/20"
                    onclick="document.dispatchEvent(new CustomEvent('player:playRow', { detail: { trackId: <%= track.id %>, contextType: 'search' } }))"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play"><path d="m5 3 14 9-14 9V3z"/></svg>
                  </button>
                  <button
                    class="absolute bottom-4 left-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-md text-white border border-white/10 flex items-center justify-center translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 hover:bg-brand-primary hover:text-bg-deep"
                    onclick="document.dispatchEvent(new CustomEvent('player:addToQueue', { detail: { trackId: <%= track.id %>, title: '<%= escape_javascript track.title %>', artist: '<%= escape_javascript track.artist.name %>', cover: '<%= track.album.cover_url %>', preview: '<%= track.preview_url %>' } }))"
                    title="Add to Queue"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-plus"><path d="M11 12H3"/><path d="M16 6H3"/><path d="M16 18H3"/><path d="M18 9v6"/><path d="M15 12h6"/></svg>
                  </button>
                </div>
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-sm font-bold text-white truncate"><%= track.title %></h3>
                    <p class="text-[11px] font-medium text-slate-500 truncate">
                      <%= link_to artist_path(track.artist), class: "hover:text-brand-primary" do %>
                        <%= track.artist.name %>
                      <% end %>
                    </p>
                  </div>
                  <div class="flex items-center gap-1 flex-shrink-0">
                    <%= render "shared/like_button", track: track %>
                    <%= render "shared/add_to_playlist", track: track %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <!-- Artists Results -->
      <% if @artists.any? %>
        <section>
          <h2 class="text-2xl font-display font-black text-white mb-6 tracking-tight">Artists</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
            <% @artists.each do |artist| %>
              <%= link_to artist_path(artist), class: "text-center group block" do %>
                <div class="aspect-square rounded-full bg-white/5 mb-4 overflow-hidden border border-white/5 group-hover:border-brand-primary/30 transition-all duration-500">
                  <% if artist.image_url.present? %>
                    <img src="<%= artist.image_url %>" class="w-full h-full object-cover group-hover:scale-110 transition-all duration-700">
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center bg-white/5">
                      <i data-lucide="user" class="w-10 h-10 text-slate-800"></i>
                    </div>
                  <% end %>
                </div>
                <h3 class="text-sm font-bold text-white group-hover:text-brand-primary transition-colors truncate"><%= artist.name %></h3>
                <p class="text-[10px] font-black text-slate-600 uppercase tracking-widest mt-1"><%= artist.primary_genre || "Artist" %></p>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if !@tracks.any? && !@artists.any? %>
         <div class="py-24 text-center">
            <i data-lucide="search-x" class="w-16 h-16 text-slate-800 mx-auto mb-6"></i>
            <h3 class="text-xl font-bold text-white mb-2">No results found for your search</h3>
            <p class="text-slate-500">Try a different category or search term.</p>
         </div>
      <% end %>
    </div>
  <% else %>
    <!-- Browse Categories / Initial State -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
      <%= link_to search_path(genre: "pop"), class: "aspect-video rounded-3xl bg-gradient-to-br from-brand-primary to-brand-secondary p-8 flex flex-col justify-end group cursor-pointer overflow-hidden relative" do %>
         <div class="absolute -top-4 -right-4 w-24 h-24 bg-white/20 blur-3xl rounded-full"></div>
         <h3 class="text-2xl font-black text-bg-deep tracking-tighter relative z-10">Pop</h3>
      <% end %>
      
      <%= link_to search_path(genre: "hip-hop"), class: "aspect-video rounded-3xl bg-gradient-to-br from-[#FF0080] to-[#7928CA] p-8 flex flex-col justify-end group cursor-pointer relative" do %>
         <h3 class="text-2xl font-black text-white tracking-tighter relative z-10">Hip-Hop</h3>
      <% end %>

      <%= link_to search_path(genre: "punjabi"), class: "aspect-video rounded-3xl bg-gradient-to-br from-[#F59E0B] to-[#D97706] p-8 flex flex-col justify-end group cursor-pointer relative" do %>
         <h3 class="text-2xl font-black text-white tracking-tighter relative z-10">Punjabi</h3>
      <% end %>

      <%= link_to search_path(genre: "electronic"), class: "aspect-video rounded-3xl bg-gradient-to-br from-[#00DFD8] to-[#007CF0] p-8 flex flex-col justify-end group cursor-pointer relative" do %>
         <h3 class="text-2xl font-black text-white tracking-tighter relative z-10">Electronic</h3>
      <% end %>

      <%= link_to search_path(genre: "latin"), class: "aspect-video rounded-3xl bg-gradient-to-br from-[#FF4D4D] to-[#F9CB28] p-8 flex flex-col justify-end group cursor-pointer relative" do %>
         <h3 class="text-2xl font-black text-white tracking-tighter relative z-10">Latin</h3>
      <% end %>
    </div>
  <% end %>
</div>
