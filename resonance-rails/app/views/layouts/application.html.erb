<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Resonance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-bg-deep text-slate-400 font-body antialiased selection:bg-brand-primary/20">
    <div class="mesh-gradient"></div>

    <!-- Flash Messages -->
    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed top-10 right-10 z-[100] flex flex-col gap-3 pointer-events-none">
      <% flash.each do |type, message| %>
        <div data-controller="toast" 
             data-toast-type-value="<%= type %>" 
             data-toast-message-value="<%= message %>" 
             class="hidden"></div>
      <% end %>
    </div>

    <div class="flex h-full overflow-hidden relative z-10">
      <% if user_signed_in? %>
        <!-- Sidebar -->
        <aside class="w-60 flex-shrink-0 bg-black/50 backdrop-blur-3xl border-r border-white/5 hidden md:flex flex-col">
          <div class="p-7">
            <%= link_to dashboard_path, class: "flex items-center gap-2 group" do %>
              <div class="w-2 h-2 rounded-full bg-brand-primary shadow-[0_0_10px_var(--color-brand-primary)] pulse-live"></div>
              <h1 class="text-[22px] font-display font-black text-white tracking-tighter group-hover:text-brand-primary transition-colors">Resonance</h1>
            <% end %>
          </div>

          <nav class="flex-1 px-4 space-y-0.5">
            <a href="<%= dashboard_path %>" class="flex items-center gap-3 px-3 py-2.5 text-[13px] font-semibold rounded-xl <%= current_page?(dashboard_path) ? 'bg-brand-primary/10 text-brand-primary' : 'text-slate-500 hover:text-white' %> transition-all">
              <i data-lucide="compass" class="w-4 h-4 flex-shrink-0"></i> Explore
            </a>
            <a href="<%= search_path %>" class="flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium rounded-xl <%= current_page?(search_path) ? 'bg-brand-primary/10 text-brand-primary' : 'text-slate-500 hover:text-white hover:bg-white/5' %> transition-all">
              <i data-lucide="search" class="w-4 h-4 flex-shrink-0"></i> Search
            </a>
            <a href="<%= library_path %>" class="flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium rounded-xl <%= current_page?(library_path) ? 'bg-brand-primary/10 text-brand-primary' : 'text-slate-500 hover:text-white hover:bg-white/5' %> transition-all">
              <i data-lucide="layers" class="w-4 h-4 flex-shrink-0"></i> Library
            </a>
            <a href="<%= queue_items_path %>" class="flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium rounded-xl <%= current_page?(queue_items_path) ? 'bg-brand-primary/10 text-brand-primary' : 'text-slate-500 hover:text-white hover:bg-white/5' %> transition-all">
              <i data-lucide="list-music" class="w-4 h-4 flex-shrink-0"></i> Queue
            </a>

            <div class="pt-7 pb-2 px-3 text-[10px] uppercase tracking-[0.15em] font-black text-slate-600">Playlists</div>
            <%= link_to new_playlist_path, class: "flex items-center gap-3 px-3 py-2 text-[13px] font-medium text-slate-500 hover:text-white transition-all group" do %>
              <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-primary group-hover:text-bg-deep transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
              </div>
              Create New
            <% end %>
            <% if @sidebar_playlists&.any? %>
              <div class="space-y-0.5 mt-1 max-h-36 overflow-y-auto">
                <% @sidebar_playlists.each do |playlist| %>
                  <a href="<%= playlist_path(playlist) %>"
                     class="flex items-center gap-2.5 px-3 py-1.5 text-[12px] font-medium rounded-xl <%= current_page?(playlist_path(playlist)) ? 'text-white bg-white/5' : 'text-slate-600 hover:text-white' %> transition-all">
                    <i data-lucide="music-2" class="w-3 h-3 flex-shrink-0"></i>
                    <span class="truncate"><%= playlist.title %></span>
                  </a>
                <% end %>
              </div>
            <% end %>
          </nav>

          <div class="p-5">
            <%= link_to profile_path, class: "flex items-center gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 cursor-pointer hover:bg-white/[0.06] transition-all group" do %>
              <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-brand-secondary to-brand-accent p-[2px] flex-shrink-0 group-hover:shadow-[0_0_15px_rgba(188,0,255,0.3)] transition-all">
                <div class="w-full h-full rounded-full bg-bg-deep flex items-center justify-center font-bold text-white text-[11px]">
                  <%= current_user.email[0..1].upcase %>
                </div>
              </div>
              <div class="flex-1 overflow-hidden">
                <p class="text-[12px] font-bold text-white truncate"><%= current_user.email.split('@').first.capitalize %></p>
                <p class="text-[10px] text-brand-primary font-bold uppercase tracking-wider">Pro Account</p>
              </div>
            <% end %>
          </div>
        </aside>
      <% end %>

      <main class="flex-1 overflow-y-auto pb-24 h-full relative">

        <header class="sticky top-0 z-10 bg-bg-deep/60 backdrop-blur-xl px-8 py-4 flex items-center justify-end border-b border-white/[0.03]">
          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <%= button_to destroy_user_session_path, method: :delete, class: "px-5 py-2 text-[12px] font-bold text-slate-400 hover:text-white transition-all" do %>
                Logout
              <% end %>
              <%= link_to "Profile", profile_path, class: "px-5 py-2 text-[12px] font-bold bg-white text-black rounded-full hover:scale-105 transition-all" %>
            <% else %>
              <%= link_to new_user_session_path, class: "px-5 py-2 text-[12px] font-bold text-white bg-white/5 border border-white/10 rounded-full hover:bg-white/10 transition-all" do %>
                Sign In
              <% end %>
              <%= link_to new_user_registration_path, class: "px-5 py-2 text-[12px] font-bold bg-white text-black rounded-full hover:scale-105 transition-all" do %>
                Sign Up
              <% end %>
            <% end %>
          </div>
        </header>

        <div class="<%= user_signed_in? ? 'px-8 py-6' : '' %>">
          <%= yield %>
        </div>
      </main>
    </div>

    <% if user_signed_in? %>
      <!-- Player Bar -->
      <footer id="player-container"
              data-turbo-permanent
              data-controller="player"
              data-player-target="container"
              class="fixed bottom-0 left-0 right-0 z-20 flex flex-col group/footer transition-all duration-700"
              style="background: rgba(8,10,14,0.92); backdrop-filter: blur(24px); border-top: 1px solid rgba(255,255,255,0.06);">

        <!-- MINI PLAYER (Standard Bar) -->
        <div class="flex items-center gap-6 px-8 w-full h-[80px]" data-player-target="miniPlayer">
          <!-- Current Track Info -->
          <div class="flex items-center gap-3 w-56 flex-shrink-0">
            <div class="relative flex-shrink-0">
              <div class="w-12 h-12 rounded-lg overflow-hidden border border-white/10 bg-white/5">
                <img data-player-target="cover"
                     src="https://picsum.photos/seed/default/200/200"
                     alt="Now Playing" class="w-full h-full object-cover">
              </div>
              <div class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-brand-primary rounded-full pulse-live border-2 border-bg-deep"></div>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="text-[13px] font-semibold text-white truncate" data-player-target="title">Not playing</h4>
              <p class="text-[11px] text-slate-500 truncate" data-player-target="artist">Click a track to start</p>
            </div>
          </div>

          <!-- Playback Controls -->
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="flex items-center gap-5">
              <button class="text-slate-500 hover:text-white transition-all"
                      data-action="click->player#toggleShuffle"
                      data-player-target="shuffleBtn">
                <i data-lucide="shuffle" class="w-4 h-4"></i>
              </button>
              <button class="text-slate-500 hover:text-white transition-all"
                      data-action="click->player#skipPrev">
                <i data-lucide="skip-back" class="w-5 h-5 fill-current"></i>
              </button>

              <!-- Play/Pause -->
              <button class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:scale-110 active:scale-95 transition-all shadow-lg"
                      data-action="click->player#togglePlay"
                      data-player-target="playBtn">
                <i data-lucide="play" class="w-5 h-5 fill-current ml-0.5" data-player-target="playIcon"></i>
              </button>

              <button class="text-slate-500 hover:text-white transition-all"
                      data-action="click->player#skipNext">
                <i data-lucide="skip-forward" class="w-5 h-5 fill-current"></i>
              </button>
              <button class="text-slate-500 hover:text-white transition-all"
                      data-action="click->player#toggleRepeat"
                      data-player-target="repeatBtn">
                <i data-lucide="repeat" class="w-4 h-4"></i>
              </button>
            </div>

            <!-- Progress Bar -->
            <div class="w-full max-w-md flex items-center gap-3">
              <span class="text-[10px] font-bold text-slate-600 font-mono w-7 text-right" data-player-target="currentTime">0:00</span>
              <div class="flex-1 h-[3px] bg-white/[0.08] rounded-full relative cursor-pointer group/bar"
                   data-player-target="progressBar"
                   data-action="click->player#seek">
                <div class="absolute inset-y-0 left-0 bg-brand-primary rounded-full transition-all"
                     data-player-target="progressFill"
                     style="width: 0%"></div>
                <div class="absolute inset-y-0 left-0 bg-brand-primary/20 rounded-full w-full group-hover/bar:bg-brand-primary/10"></div>
              </div>
              <span class="text-[10px] font-bold text-slate-600 font-mono w-7" data-player-target="duration">0:00</span>
            </div>
          </div>

          <!-- Volume & Extras -->
          <div class="flex items-center justify-end gap-4 w-56 flex-shrink-0">
            <button class="text-slate-500 hover:text-white transition-all"
                    data-action="click->player#toggleQueue">
              <i data-lucide="list-music" class="w-4 h-4"></i>
            </button>
            <div class="flex items-center gap-2">
              <i data-lucide="volume-2" class="w-4 h-4 text-slate-500"></i>
              <div class="w-20 h-[3px] bg-white/[0.08] rounded-full cursor-pointer relative"
                   data-player-target="volume"
                   data-action="click->player#setVolume">
                <div class="absolute inset-y-0 left-0 bg-brand-primary rounded-full"
                     data-player-target="volumeFill"
                     style="width: 100%"></div>
              </div>
            </div>
            <button class="text-slate-500 hover:text-white transition-all"
                    data-action="click->player#toggleFullscreen">
              <i data-lucide="maximize" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <!-- FULL PLAYER (Immersive Overlay) -->
        <div class="hidden fixed inset-0 z-50 bg-bg-deep flex flex-col items-center justify-between py-16 px-12"
             data-player-target="fullPlayer">
          
          <!-- Blurred Background -->
          <div class="absolute inset-0 z-0 opacity-40 blur-[100px] pointer-events-none">
            <img data-player-target="fullBg" src="" class="w-full h-full object-cover">
          </div>

          <!-- Header -->
          <div class="relative z-10 w-full flex justify-between items-center max-w-4xl">
            <button class="p-3 rounded-2xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all"
                    data-action="click->player#toggleFullscreen">
              <i data-lucide="chevron-down" class="w-6 h-6"></i>
            </button>
            <div class="text-center">
              <p class="text-[10px] font-black text-slate-500 uppercase tracking-[0.4em] mb-1">Now Playing From</p>
              <p class="text-sm font-bold text-white tracking-tight" data-player-target="fullContext">Resonance Discovery</p>
            </div>
            <button class="p-3 rounded-2xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all">
              <i data-lucide="more-horizontal" class="w-6 h-6"></i>
            </button>
          </div>

          <!-- Center Content: Artwork -->
          <div class="relative z-10 flex flex-col items-center gap-12 w-full max-w-lg">
            <div class="w-full aspect-square rounded-[2rem] overflow-hidden shadow-[0_20px_80px_-20px_rgba(0,0,0,0.8)] border border-white/10 group">
              <img data-player-target="fullCover" src="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
            </div>
            <div class="text-center w-full">
              <h2 class="text-4xl md:text-5xl font-display font-black text-white tracking-tighter mb-2" data-player-target="fullTitle">Not playing</h2>
              <p class="text-lg md:text-xl font-medium text-slate-400" data-player-target="fullArtist">Tap a track</p>
            </div>
          </div>

          <!-- Footer Controls -->
          <div class="relative z-10 w-full max-w-4xl space-y-8">
            <!-- Progress -->
            <div class="space-y-3">
              <div class="flex items-center gap-4 h-2 bg-white/[0.05] rounded-full relative cursor-pointer group/fullbar"
                   data-player-target="fullProgressBar"
                   data-action="click->player#seek">
                <div class="absolute inset-y-0 left-0 bg-white rounded-full transition-all"
                     data-player-target="fullProgressFill"
                     style="width: 0%"></div>
              </div>
              <div class="flex justify-between text-[11px] font-black text-slate-500 tabular-nums uppercase tracking-widest">
                <span data-player-target="fullCurrentTime">0:00</span>
                <span data-player-target="fullDuration">0:00</span>
              </div>
            </div>

            <!-- Controls -->
            <div class="flex justify-between items-center px-4">
               <button class="text-slate-500 hover:text-white transition-all transform hover:scale-110 active:scale-95" 
                       data-action="click->player#toggleShuffle"
                       data-player-target="fullShuffleBtn">
                 <i data-lucide="shuffle" class="w-6 h-6"></i>
               </button>
               
               <div class="flex items-center gap-8">
                 <button class="text-white hover:text-brand-primary transition-all transform hover:scale-110 active:scale-90"
                         data-action="click->player#skipPrev">
                   <i data-lucide="skip-back" class="w-8 h-8 fill-current"></i>
                 </button>
                 
                 <button class="w-20 h-20 rounded-full bg-white text-bg-deep flex items-center justify-center hover:scale-105 active:scale-95 transition-all shadow-2xl"
                         data-action="click->player#togglePlay"
                         data-player-target="fullPlayBtn">
                   <i data-lucide="play" class="w-10 h-10 fill-current ml-1" data-player-target="fullPlayIcon"></i>
                 </button>
                 
                 <button class="text-white hover:text-brand-primary transition-all transform hover:scale-110 active:scale-90"
                         data-action="click->player#skipNext">
                   <i data-lucide="skip-forward" class="w-8 h-8 fill-current"></i>
                 </button>
               </div>

               <button class="text-slate-500 hover:text-white transition-all transform hover:scale-110 active:scale-95"
                       data-action="click->player#toggleRepeat"
                       data-player-target="fullRepeatBtn">
                 <i data-lucide="repeat" class="w-6 h-6"></i>
               </button>
            </div>
          </div>
        </div>
      </footer>
    <% end %>

    <script>
      // Force initial icon render
      document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) { lucide.createIcons(); }
        
        // Flash message cleanup
        document.querySelectorAll('.flash-msg').forEach(function(msg) {
          setTimeout(function() {
            msg.style.opacity = '0';
            msg.style.transform = 'translateY(-8px)';
            setTimeout(function() { msg.remove(); }, 500);
          }, 2500);
        });
      });
    </script>
  </body>
</html>