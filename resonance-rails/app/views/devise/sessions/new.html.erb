<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md p-10 rounded-[2.5rem] bg-bg-surface border border-white/5 shadow-2xl relative overflow-hidden">
    <!-- Background Glow -->
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-brand-primary/10 blur-[100px] rounded-full"></div>

    <div class="relative z-10">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-display font-black text-white mb-2 tracking-tighter">Welcome Back</h2>
        <p class="text-xs font-bold text-slate-500 uppercase tracking-widest leading-loose">Enter your frequency coordinates</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-6">
          <div class="space-y-2">
            <%= f.label :email, class: "text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "your@email.com", 
                class: "w-full px-6 py-4 rounded-2xl bg-white/[0.03] border border-white/10 text-white placeholder:text-slate-700 outline-none focus:border-brand-primary/50 transition-all" %>
          </div>

          <div class="space-y-2">
            <%= f.label :password, class: "text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1" %>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••",
                class: "w-full px-6 py-4 rounded-2xl bg-white/[0.03] border border-white/10 text-white placeholder:text-slate-700 outline-none focus:border-brand-primary/50 transition-all" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-3 px-1">
              <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-white/10 bg-white/5 text-brand-primary focus:ring-offset-bg-deep" %>
              <%= f.label :remember_me, class: "text-xs font-semibold text-slate-500" %>
            </div>
          <% end %>

          <div class="pt-4">
            <%= f.submit "Sign In", class: "btn-primary w-full py-4 text-sm" %>
          </div>
        </div>
      <% end %>

      <div class="mt-10 pt-8 border-t border-white/5 text-center">
        <p class="text-xs text-slate-500">
          New to Resonance? 
          <%= link_to "Create Account", new_registration_path(resource_name), class: "text-white font-bold hover:text-brand-primary transition-colors ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
