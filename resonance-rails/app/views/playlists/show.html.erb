<div class="max-w-5xl mx-auto px-8 py-12">
  <!-- Playlist Hero -->
  <div class="flex items-end gap-8 mb-12 p-8 rounded-[2.5rem] bg-white/[0.02] border border-white/5 relative overflow-hidden">
    <div class="absolute -top-20 -left-20 w-72 h-72 bg-brand-secondary/10 blur-[120px] rounded-full"></div>

    <div class="relative z-10 w-40 h-40 rounded-2xl bg-gradient-to-br from-brand-secondary/30 to-brand-accent/30 flex items-center justify-center flex-shrink-0 border border-white/10">
      <i data-lucide="music-2" class="w-16 h-16 text-white/30"></i>
    </div>

    <div class="relative z-10 flex-1">
      <p class="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] mb-2">Playlist</p>
      <h1 class="text-5xl font-display font-black text-white tracking-tighter mb-3"><%= @playlist.title %></h1>
      <% if @playlist.description.present? %>
        <p class="text-slate-400 mb-4 max-w-lg"><%= @playlist.description %></p>
      <% end %>
      <p class="text-sm text-slate-600">
        By <span class="text-white font-semibold"><%= @playlist.user.email.split('@').first.capitalize %></span>
        &nbsp;•&nbsp; <%= pluralize(@playlist.tracks.count, 'song') %>
      </p>
    </div>

    <% if @playlist.user == current_user %>
      <div class="relative z-10 flex gap-3">
        <%= link_to edit_playlist_path(@playlist), class: "p-3 rounded-2xl bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-all" do %>
          <i data-lucide="pencil" class="w-5 h-5"></i>
        <% end %>
        <%= button_to playlist_path(@playlist), method: :delete, data: { turbo_confirm: "Delete this playlist?" },
            class: "p-3 rounded-2xl bg-white/5 border border-white/10 text-slate-400 hover:text-red-400 hover:bg-red-500/10 transition-all" do %>
          <i data-lucide="trash-2" class="w-5 h-5"></i>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Track List -->
  <% if @playlist.tracks.any? %>
    <div class="flex flex-col gap-1">
      <% @playlist.tracks.each_with_index do |track, i| %>
        <div class="flex items-center gap-4 px-5 py-3 rounded-2xl hover:bg-white/[0.04] group transition-all">
          <span class="text-[12px] font-bold text-slate-700 w-5 text-center flex-shrink-0 group-hover:hidden"><%= i + 1 %></span>
          <div class="hidden group-hover:flex w-5 justify-center cursor-pointer"
               onclick="document.dispatchEvent(new CustomEvent('player:playRow', { detail: { trackId: <%= track.id %>, contextType: 'playlist', contextId: <%= @playlist.id %> } }))">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play text-brand-primary"><path d="m5 3 14 9-14 9V3z"/></svg>
          </div>
          <div class="w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 bg-white/5 border border-white/5">
            <% if track.album.cover_url.present? %>
              <img src="<%= track.album.cover_url %>" class="w-full h-full object-cover">
            <% end %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[13px] font-semibold text-white truncate group-hover:text-brand-primary transition-colors"><%= track.title %></p>
            <p class="text-[11px] text-slate-500 truncate cursor-default">
              <%= link_to track.artist.name, artist_path(track.artist), class: "hover:text-brand-primary transition-colors", onclick: "event.stopPropagation();" %>
            </p>
          </div>
          <div class="flex items-center gap-3">
            <button class="p-2 rounded-xl bg-white/5 border border-white/10 text-slate-500 hover:text-brand-primary hover:bg-brand-primary/10 transition-all opacity-0 group-hover:opacity-100"
                    onclick="document.dispatchEvent(new CustomEvent('player:addToQueue', { detail: { trackId: <%= track.id %>, title: '<%= escape_javascript track.title %>', artist: '<%= escape_javascript track.artist.name %>', cover: '<%= track.album.cover_url %>', preview: '<%= track.preview_url %>' } }))"
                    title="Add to Queue">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-plus"><path d="M11 12H3"/><path d="M16 6H3"/><path d="M16 18H3"/><path d="M18 9v6"/><path d="M15 12h6"/></svg>
            </button>
            <%= render "shared/like_button", track: track %>
            <% if @playlist.user == current_user %>
              <% pt = track.playlist_tracks.find_by(playlist_id: @playlist.id) %>
              <% if pt %>
                <%= button_to playlist_track_path(pt),
                      method: :delete,
                      class: "p-2 rounded-xl text-slate-700 hover:text-red-400 hover:bg-red-500/10 transition-all opacity-0 group-hover:opacity-100",
                      title: "Remove from playlist" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                <% end %>
              <% end %>
            <% end %>
            <span class="text-[12px] text-slate-700 tabular-nums w-10 text-right">
              <% mins = track.duration_seconds.to_i / 60; secs = track.duration_seconds.to_i % 60 %>
              <%= "#{mins}:#{'%02d' % secs}" %>
            </span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="py-24 text-center border border-dashed border-white/10 rounded-[2.5rem]">
      <i data-lucide="music-2" class="w-16 h-16 text-slate-800 mx-auto mb-6"></i>
      <h3 class="text-xl font-bold text-white mb-2">This playlist is empty</h3>
      <p class="text-slate-500 mb-8">Search for songs and add them to get started.</p>
      <%= link_to "Find Songs", search_path, class: "btn-primary py-3 px-8 text-sm" %>
    </div>
  <% end %>
</div>
