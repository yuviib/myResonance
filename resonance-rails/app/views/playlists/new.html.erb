<div class="max-w-2xl mx-auto px-8 py-12">
  <div class="mb-10">
    <h1 class="text-4xl font-display font-black text-white tracking-tighter mb-2">Create Playlist</h1>
    <p class="text-slate-500">Give your collection a name and let the music flow.</p>
  </div>

  <div class="p-10 rounded-[2.5rem] bg-white/[0.03] border border-white/5 relative overflow-hidden">
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-brand-secondary/10 blur-[100px] rounded-full"></div>

    <%= form_with model: @playlist, class: "relative z-10 space-y-6" do |f| %>
      <% if @playlist.errors.any? %>
        <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
          <%= @playlist.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :title, class: "text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1" %>
        <%= f.text_field :title, placeholder: "My Awesome Playlist",
            class: "w-full px-6 py-4 rounded-2xl bg-white/[0.03] border border-white/10 text-white placeholder:text-slate-700 outline-none focus:border-brand-primary/50 transition-all" %>
      </div>

      <div class="space-y-2">
        <%= f.label :description, class: "text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1" %>
        <%= f.text_area :description, rows: 4, placeholder: "Describe your vibe...",
            class: "w-full px-6 py-4 rounded-2xl bg-white/[0.03] border border-white/10 text-white placeholder:text-slate-700 outline-none focus:border-brand-primary/50 transition-all resize-none" %>
      </div>

      <div class="flex gap-4 pt-4">
        <%= f.submit "Create Playlist", class: "btn-primary py-4 px-10 text-sm cursor-pointer" %>
        <%= link_to "Cancel", library_path, class: "btn-outline py-4 px-10 text-sm" %>
      </div>
    <% end %>
  </div>
</div>
