<div id="<%= dom_id(item) %>" class="flex items-center gap-4 px-5 py-3 rounded-2xl hover:bg-white/[0.04] group transition-all">
  <span class="text-[12px] font-bold text-slate-700 w-5 text-center flex-shrink-0 group-hover:hidden"><%= index + 1 %></span>
  <div class="hidden group-hover:flex w-5 justify-center cursor-pointer"
       onclick="document.dispatchEvent(new CustomEvent('player:playRow', { detail: { trackId: <%= item.track.id %> } }))">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play text-brand-primary"><path d="m5 3 14 9-14 9V3z"/></svg>
  </div>
  <div class="w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 bg-white/5 border border-white/5">
    <% if item.track.album.cover_url.present? %>
      <img src="<%= item.track.album.cover_url %>" class="w-full h-full object-cover">
    <% end %>
  </div>
  <div class="flex-1 min-w-0">
    <p class="text-[13px] font-semibold text-white truncate group-hover:text-brand-primary transition-colors"><%= item.track.title %></p>
    <p class="text-[11px] text-slate-500 truncate cursor-default">
      <%= link_to item.track.artist.name, artist_path(item.track.artist), class: "hover:text-brand-primary transition-colors", onclick: "event.stopPropagation();" %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= button_to queue_item_path(item),
          method: :delete,
          class: "p-2 rounded-xl text-slate-700 hover:text-red-400 hover:bg-red-500/10 transition-all opacity-0 group-hover:opacity-100",
          title: "Remove from queue" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
    <% end %>
    <span class="text-[12px] text-slate-700 tabular-nums w-10 text-right">
      <% mins = item.track.duration_seconds.to_i / 60; secs = item.track.duration_seconds.to_i % 60 %>
      <%= "#{mins}:#{'%02d' % secs}" %>
    </span>
  </div>
</div>
